# =============================================================================
# Coding Agent Template – Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values you need.
#
# LOCAL DEVELOPMENT (no cloud DB required):
#   - Leave POSTGRES_URL unset (or empty) → the app automatically uses SQLite
#     (file: local.db in the project root).
#   - You still need OAuth + encryption secrets to sign in and create tasks.
#
# PRODUCTION / Vercel:
#   - Set POSTGRES_URL (Neon is provisioned automatically on "Deploy with Vercel").
# =============================================================================

# -----------------------------------------------------------------------------
# Database (optional for local)
# -----------------------------------------------------------------------------
# Neon / Postgres connection string.
# If unset or empty, SQLite (better-sqlite3) is used as a local fallback.
# Example (Neon): postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# POSTGRES_URL=

# Optional explicit SQLite path (only used when POSTGRES_URL is unset)
# SQLITE_URL=file:local.db

# -----------------------------------------------------------------------------
# Required for any environment (local + production)
# -----------------------------------------------------------------------------
# Session encryption (generate: openssl rand -base64 32)
JWE_SECRET=

# Encryption key for tokens / API keys (generate: openssl rand -hex 32)
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Vercel Sandbox (required to actually run agents)
# -----------------------------------------------------------------------------
SANDBOX_VERCEL_TOKEN=
SANDBOX_VERCEL_TEAM_ID=
SANDBOX_VERCEL_PROJECT_ID=

# -----------------------------------------------------------------------------
# Authentication – enable at least one provider
# -----------------------------------------------------------------------------
# Comma-separated list: "github", "vercel", or "github,vercel"
NEXT_PUBLIC_AUTH_PROVIDERS=github

# GitHub OAuth (if github is enabled)
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Vercel OAuth (if vercel is enabled)
NEXT_PUBLIC_VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Optional – global API keys (users can also set their own in the UI)
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# AI_GATEWAY_API_KEY=
# OPENAI_API_KEY=
# CURSOR_API_KEY=
# GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Optional tuning
# -----------------------------------------------------------------------------
# MAX_SANDBOX_DURATION=300
# MAX_MESSAGES_PER_DAY=5
